{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "rootDir": "src",
    "outDir": "../static",
    "sourceMap": false,
    "declaration": false,
    "removeComments": true,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}

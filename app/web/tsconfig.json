{
  // Browser code only. Output lands next to index.html and is committed, so the
  // Python app keeps running with no Node toolchain on show machines.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "rootDir": "src",
    "outDir": "../trio_mix/static",
    "sourceMap": false,
    "declaration": false,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}

{
  "name": "trio-mix-ts",
  "private": true,
  "version": "0.2.9",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Trio Mix-Assistant. src/core has no platform APIs.",
  "scripts": {
    "check": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\"",
    "package": "node --experimental-strip-types --no-warnings tools/package.ts",
    "start": "node --experimental-strip-types --no-warnings src/host/launch.ts",
    "run": "node --experimental-strip-types --no-warnings src/host/main.ts",
    "osc-demo": "node --experimental-strip-types --no-warnings src/host/oscdemo-cli.ts",
    "exe": "node --experimental-strip-types --no-warnings tools/sea.ts",
    "lint": "node --experimental-strip-types --no-warnings tools/guard.ts",
    "test:serial": "node --experimental-strip-types --no-warnings --test --test-concurrency=1 \"test/serial/*.serial.ts\"",
    "bench": "node --experimental-strip-types --no-warnings bench/blocks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "22.20.5",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "naudiodon2": "2.5.0"
  }
}
